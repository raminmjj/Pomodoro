<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pomodoro.App.Views.MainView">

  <Border Padding="32">
    <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">

      <TextBlock Classes="Phase" Text="{Binding PhaseLabel}" />

      <TextBlock Classes="Hero" Text="{Binding TimeRemaining}" />

      <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Width="280" />

      <TextBlock Classes="Caption" Text="{Binding CurrentTaskTitle}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
        <Button Content="Start"  Classes="Primary"   Command="{Binding StartCommand}"  IsEnabled="{Binding CanStart}"  />
        <Button Content="Pause"  Classes="Secondary" Command="{Binding PauseCommand}"  IsEnabled="{Binding CanPause}"  />
        <Button Content="Resume" Classes="Secondary" Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}" />
        <Button Content="Skip"   Classes="Secondary" Command="{Binding SkipCommand}"   IsEnabled="{Binding CanPause}"  />
        <Button Content="Stop"   Classes="Secondary" Command="{Binding StopCommand}"   IsEnabled="{Binding CanStop}"   />
      </StackPanel>

      <TextBlock Classes="Caption" Text="{Binding CycleIndex, StringFormat='Cycle #{0}'}"
                 HorizontalAlignment="Center" Margin="0,12,0,0" />
    </StackPanel>
  </Border>
</UserControl>
