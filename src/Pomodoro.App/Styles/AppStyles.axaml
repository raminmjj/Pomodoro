<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="FontFamily" Value="Inter, Segoe UI, -apple-system, sans-serif" />
    </Style>

    <Style Selector="TextBlock.Hero">
        <Setter Property="FontSize" Value="64" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="#0F172A" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.Phase">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#5B6B7D" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="TextBlock.H1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#0F172A" />
    </Style>

    <Style Selector="TextBlock.H2">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#0F172A" />
    </Style>

    <Style Selector="TextBlock.Caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#5B6B7D" />
    </Style>

    <Style Selector="Button.Primary">
        <Setter Property="Background" Value="#1B6B7A" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinWidth" Value="100" />
    </Style>

    <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#15525E" />
    </Style>

    <Style Selector="Button.Secondary">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#1B6B7A" />
        <Setter Property="BorderBrush" Value="#1B6B7A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinWidth" Value="100" />
    </Style>

    <Style Selector="Border.Card">
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="0 2 12 0 #15000000" />
    </Style>

    <Style Selector="Border.Kpi">
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="#1B6B7A" />
        <Setter Property="Background" Value="#E2E8F0" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>
</Styles>
